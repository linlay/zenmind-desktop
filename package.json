{
  "name": "zenmind-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ZenMind 应用壳",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "sync:assets": "node ./scripts/sync-builtin-assets.mjs",
    "build:main:types": "tsc -p tsconfig.main.json",
    "build:main:bundle": "node ./scripts/build-main-bundle.mjs",
    "build:main": "npm run build:main:types && npm run build:main:bundle",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "stage:app": "node ./scripts/stage-app.mjs",
    "dev": "node ./scripts/dev.mjs",
    "start": "npm run dev",
    "dist:mac": "node ./scripts/sync-builtin-assets.mjs --os=darwin --arch=arm64 && npm run build && npm run stage:app -- --os=darwin --arch=arm64 && electron-builder --mac --arm64",
    "dist:win": "node ./scripts/sync-builtin-assets.mjs --os=windows --arch=amd64 && npm run build && npm run stage:app -- --os=win32 --arch=x64 && electron-builder --win --x64",
    "dist:win-docker": "node ./scripts/dist-win.mjs",
    "test": "npm run build && node --test ./test/*.test.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@page-agent/core": "^1.8.1",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.7.2",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.7.284",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.5.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^36.2.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "cc.zenmind.desktop",
    "productName": "ZenMind",
    "directories": {
      "app": "build/app"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@napi-rs/canvas-linux-*",
      "!node_modules/@napi-rs/canvas-linux-*/**/*",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/canvas-*/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/resources/services",
        "to": "services"
      },
      {
        "from": "scripts",
        "to": ".",
        "filter": [
          "uninstall.sh"
        ]
      }
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ZenMind 使用麦克风将你的语音输入转成文字。",
        "NSSpeechRecognitionUsageDescription": "ZenMind 使用系统语音识别将你的语音输入转成文字。"
      },
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "signIgnore": [
        ".*"
      ]
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "afterPack": "./scripts/fix-mac-sign.js",
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
